# --- Base de datos operativa ---
# El backend usa SQLAlchemy async; si el esquema es "postgresql://" se normaliza
# a "postgresql+asyncpg://" automáticamente (src/core/config.py). Ambas formas valen.
#
# El docker-compose.yml expone Postgres en el puerto 15432 del host (no el 5432
# estandar) porque en Windows algunas suites de antivirus/EDR interceptan y
# cortan conexiones asyncpg en el puerto por defecto de Postgres (5432),
# devolviendo un reset de conexion a mitad de la negociacion del protocolo. Usar
# un puerto no estandar evita ese problema; dentro de la red de Docker el
# contenedor sigue escuchando en su 5432 interno normal.
DATABASE_URL=postgresql+asyncpg://sira:sira@127.0.0.1:15432/sira

# Usados por docker-compose.yml al crear el contenedor de PostgreSQL.
POSTGRES_USER=sira
POSTGRES_PASSWORD=sira
POSTGRES_DB=sira

# --- Auth (feature 008) ---
JWT_SECRET=
# Generar con: openssl rand -hex 32  (o: python -c "import secrets; print(secrets.token_hex(32))")
# Nunca commitear el valor real — este archivo es .env.example, va al repo sin claves;
# el valor real vive solo en backend/.env, ya excluido en .gitignore.
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# --- MinIO (3 buckets, constitution.md: landing-zone [raw ELT, feature 010],
#     producto-imagenes [001], comprobantes-venta [001]) ---
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_PRODUCTO_IMAGENES=producto-imagenes
MINIO_BUCKET_COMPROBANTES=comprobantes-venta
# Credenciales de tu propio servidor MinIO local (ej. Docker), no de un proveedor externo:
# deben coincidir con MINIO_ROOT_USER/MINIO_ROOT_PASSWORD (o access/secret key) con los que
# levantes el contenedor de MinIO. No hay un valor "correcto" universal — los defines tú al
# levantar MinIO y los repites aquí tal cual.

# --- ClickHouse (warehouse, construido por 010-plataforma-datos-tactico-estrategico — en pausa) ---
# Lo usan únicamente los DAGs/jobs de 010. 009-dashboards-multinivel NUNCA consulta ClickHouse
# directamente (Principio III) — solo lee el snapshot ya publicado en PostgreSQL.
CLICKHOUSE_URL=

# --- Stripe (feature 001, modo test/sandbox — extendido por 007 para seguridad de pagos) ---
STRIPE_SECRET_KEY=
# Sin STRIPE_WEBHOOK_SECRET: el cobro se confirma de forma síncrona (Payment Intents,
# lee el resultado al instante) — ningún contrato/tarea de 001 o 007 define un endpoint
# receptor de webhook (research.md de 001, Decisión 6). Se quitó por no corresponder
# a ningún flujo documentado.

# --- SendGrid (features 002/008) ---
SENDGRID_API_KEY=
# Remitente verificado en tu cuenta de SendGrid (Single Sender o dominio verificado) —
# SendGrid rechaza el envío si el "from" no está verificado en tu cuenta. Es tu propio
# correo/dominio, no algo que Claude Code pueda generar por ti.
SENDGRID_FROM_EMAIL=

# --- Open Food Facts / Open Prices (001/003) ---
# Ninguna de las dos requiere API key — ambas son públicas de solo lectura (research.md de 001 y 003 §5).
OPENFOODFACTS_BASE_URL=https://world.openfoodfacts.org

# --- Unsplash (001 — imágenes de producto para el catálogo genérico del dataset) ---
# El dataset Dunnhumby llega sin fotos; se busca una imagen genérica por nombre.
# Registra una app en https://unsplash.com/oauth/applications y copia el Access Key.
# Tier "Demo" = 50 req/hora. Vacío ⇒ se usa el placeholder por categoría (Principio II).
UNSPLASH_ACCESS_KEY=

# --- App (opcionales — todos tienen valor por defecto en src/core/config.py) ---
APP_ENV=development
DB_ECHO=false
# Orígenes permitidos por CORS (coma-separados). El frontend Vite corre en :5173.
CORS_ORIGINS=http://localhost:5173

# Notas de uso en la feature 001:
#  - STRIPE_SECRET_KEY (sk_test_...): cobro con tarjeta del punto de venta (FR-030).
#    Sin clave, el simulador cae a un stub determinístico (aprobado/rechazado/error_tecnico).
#  - SENDGRID_API_KEY + SENDGRID_FROM_EMAIL: pedido especial a proveedor (FR-029) y
#    aviso de quiebre de alta demanda (FR-043). Sin clave, el evento queda en el log
#    (el registro de negocio nunca depende del correo — Principio II).
#  - MINIO_*: comprobante de venta en PDF (FR-004), bucket 'comprobantes-venta'.
#    Sin MinIO, la venta igual se confirma y el comprobante se regenera después.
